#!/usr/bin/env bash
# 兜底：本地 main 只能指向 origin/main 上已有的提交。
# pre-commit 拦不住 merge、cherry-pick、revert 等方式改写 main；这里在引用更新时统一检查。
# git pull 快进、对齐 origin/main（reset、branch -f）都不受影响。需要 git 2.28 及以上。
set -uo pipefail
[ "${1:-}" = "prepared" ] || exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r old new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  case "$new" in "$zero"|ref:*) continue ;; esac
  if git rev-parse -q --verify refs/remotes/origin/main >/dev/null \
     && git merge-base --is-ancestor "$new" refs/remotes/origin/main 2>/dev/null; then
    continue
  fi
  cat >&2 <<'MSG'
已拒绝：本地 main 只能指向 origin/main 上已有的提交（merge、cherry-pick、revert、commit 都不行）。
请切到功能分支再做这些操作，例如：git switch -c <type>/<简述>
MSG
  status=1
done
exit "$status"
